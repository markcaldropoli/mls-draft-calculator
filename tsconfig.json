{
"compilerOptions": {
"target": "ES2020",
"lib": ["DOM", "ES2020", "DOM.Iterable"],
"jsx": "react-jsx",
"module": "ES2020",
"moduleResolution": "Node",
"allowJs": true,
"skipLibCheck": true,
"esModuleInterop": true,
"forceConsistentCasingInFileNames": true,
"strict": false,
"noEmit": true,
"resolveJsonModule": true,
"isolatedModules": true
},
"include": ["src"]
}